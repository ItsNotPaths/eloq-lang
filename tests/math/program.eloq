include math

Direction :: struct
	y : float
	x : float

state math_use
	velocity := Vector3{3, 4, 0}
	speed    := 0.0
	unit     := Vector3{0, 0, 0}
	angle    := 0.0
	rounded  := Vector3{1.4, 2.6, -0.5}
	circle   := 0.0
	flat     := Vector2{6, 8}
	flat_speed := 0.0
	flat_unit  := Vector2{0, 0}
	root       := 0.0

to_direction ::
	$Direction.y = $Vector3.y
	Direction.x = Vector3.x

add_half ::
	$Vector3 = Vector3 + 0.5

copy_float ::
	$float = float

root_of_speed :: speed |sqrt|

full_turn ::
	$float = tau

velocity |length|        speed
flat     |length|        flat_speed
flat     |normalize|     flat_unit
velocity |normalize|     unit
velocity |to_direction| |atan2| angle
rounded  |add_half| |floor|    rounded
circle   |full_turn|     circle
root_of_speed |copy_float| root
