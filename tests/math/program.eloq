insert math

state math_use
	velocity := Vector3{3, 4, 0}
	speed    := 0.0
	unit     := Vector3{0, 0, 0}
	angle    := 0.0
	rounded  := Vector3{1.4, 2.6, -0.5}
	circle   := 0.0

heading_angle ::
	$float = atan2(velocity.y, velocity.x)

round_all ::
	$Vector3 = floor(Vector3 + 0.5)

full_turn ::
	$float = tau

velocity |length|        speed
velocity |normalize|     unit
angle    |heading_angle| angle
rounded  |round_all|     rounded
circle   |full_turn|     circle
